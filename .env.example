# PostgreSQL connection string used by Prisma (@prisma/adapter-pg)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret protecting the seed/sync endpoints (/api/sync-db, sync-extras, sync-brands).
# Must be set on the server; sync endpoints fail closed (401) when unset.
SYNC_SECRET="change-me"

# Secret used to HMAC-sign auth tokens. Must be set on the server;
# login/register return 500 when unset.
AUTH_SECRET="change-me"

# کلید API نوسان (ناواسان) برای قیمت لحظه‌ای طلا و سکه — روزی ۳ درخواست (هر ۸ ساعت)
NAVASAN_API_KEY=""

# --- Backblaze B2 (جایگزین Vercel Blob برای ذخیره‌ی عکس/ویدیو، بدون نیاز به کارت اعتباری) ---
# اندپوینت S3-compatible مخصوص اکانتت (تو داشبورد B2 کنار باکت نشون داده می‌شه)
# مثال: https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=""
# بخش region از همون endpoint (مثال بالا: us-west-004)
B2_REGION=""
# keyID و applicationKey که موقع ساخت Application Key می‌گیری
B2_ACCESS_KEY_ID=""
B2_SECRET_ACCESS_KEY=""
# نام باکتی که ساختی (مثلاً digikala-clone-media)
B2_BUCKET_NAME=""
# دامنه‌ی عمومی برای دسترسی به فایل‌ها: یا آدرس friendly URL پیش‌فرض B2
# (https://f004.backblazeb2.com/file/BUCKET_NAME) یا یک custom domain متصل‌شده
# نکته: بخش "/file/BUCKET_NAME" را هم داخل همین مقدار بگذار (بدون اسلش انتهایی)
B2_PUBLIC_URL=""
