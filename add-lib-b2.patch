+++ b/src/lib/b2.ts
@@ -0,0 +1,102 @@
+import {
+  S3Client,
+  PutObjectCommand,
+  DeleteObjectCommand,
+} from "@aws-sdk/client-s3";
+
+// کلاینت S3-compatible برای Backblaze B2.
+// region باید مطابق endpoint ست بشه (مثلاً endpoint: https://s3.us-west-004.backblazeb2.com -> region: us-west-004)
+export const b2 = new S3Client({
+  region: requireEnv("B2_REGION") || "us-west-004",
+  endpoint: requireEnv("B2_ENDPOINT"),
+  credentials: {
+    accessKeyId: requireEnv("B2_ACCESS_KEY_ID"),
+    secretAccessKey: requireEnv("B2_SECRET_ACCESS_KEY"),
+  },
+});
+
+function requireEnv(name: string): string {
+  const value = process.env[name];
+  if (!value) {
+    // در build-time بعضی مسیرها import می‌شن بدون این‌که واقعاً صدا زده بشن؛
+    // پرتاب خطا رو به زمان صدا زدن واقعی موکول می‌کنیم، نه import.
+    return "";
+  }
+  return value;
+}
+
+export function bucketName(): string {
+  const bucket = process.env.B2_BUCKET_NAME;
+  if (!bucket) throw new Error("B2_BUCKET_NAME تنظیم نشده است");
+  return bucket;
+}
+
+// چون باکت B2 روی Private مونده (بدون نیاز به کارت اعتباری برای فعال‌سازی Public)،
+// فایل‌ها از طریق route داخلی خودمون سرو می‌شن: /api/media/<key>
+// این تابع همون URL داخلی رو می‌سازه که در دیتابیس ذخیره و برای <img>/<video> استفاده می‌شه.
+const MEDIA_PROXY_PREFIX = "/api/media/";
+
+function toProxyUrl(key: string): string {
+  return `${MEDIA_PROXY_PREFIX}${key}`;
+}
+
+function keyFromProxyUrl(url: string): string {
+  const idx = url.indexOf(MEDIA_PROXY_PREFIX);
+  if (idx === -1) {
+    throw new Error(`URL مربوط به پراکسی مدیای داخلی نیست: ${url}`);
+  }
+  return url.slice(idx + MEDIA_PROXY_PREFIX.length);
+}
+
+type PutOptions = {
+  access?: "public"; // برای سازگاری با امضای قبلی @vercel/blob؛ سرو واقعی از طریق route داخلی انجام می‌شه
+  contentType?: string;
+};
+
+type PutResult = {
+  url: string;
+};
+
+/**
+ * جایگزین put از @vercel/blob. همون امضا رو حفظ می‌کنه تا فراخوانی‌های
+ * موجود در route ها بدون تغییر ساختاری کار کنن.
+ * فایل روی B2 (Private) آپلود می‌شه و یه URL داخلی (/api/media/...) برمی‌گردونه.
+ */
+export async function put(
+  key: string,
+  body: Buffer | File | Blob,
+  options: PutOptions = {}
+): Promise<PutResult> {
+  let uploadBody: Buffer;
+  if (body instanceof Buffer) {
+    uploadBody = body;
+  } else {
+    uploadBody = Buffer.from(await (body as Blob).arrayBuffer());
+  }
+
+  await b2.send(
+    new PutObjectCommand({
+      Bucket: bucketName(),
+      Key: key,
+      Body: uploadBody,
+      ContentType: options.contentType,
+    })
+  );
+
+  return { url: toProxyUrl(key) };
+}
+
+/**
+ * جایگزین del از @vercel/blob. ورودی همون URL داخلی (/api/media/...) است؛
+ * کلید واقعی روی B2 از روش استخراج می‌شه.
+ */
+export async function del(url: string): Promise<void> {
+  const key = keyFromProxyUrl(url);
+
+  await b2.send(
+    new DeleteObjectCommand({
+      Bucket: bucketName(),
+      Key: key,
+    })
+  );
+}
